{
  "name": "cortico-world-music-abc",
  "version": "0.1.0",
  "type": "module",
  "description": "让Coo用ABC谱创作音乐。",
  "license": "MIT",
  "author": "AqualCross",
  "repository": { "type": "git", "url": "git+https://github.com/AqualCross/cortico-world-music-abc.git" },
  "homepage": "https://github.com/AqualCross/cortico-world-music-abc#readme",
  "bugs": { "url": "https://github.com/AqualCross/cortico-world-music-abc/issues" },
  "keywords": ["cortico-world", "cortico", "coopanion", "music", "abc", "sheet-music", "soundfont"],
  "engines": { "node": ">=22" },
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js" },
  "files": ["src", "dist", "assets/icon.png", "assets/manifest.json", "assets/GeneralUser-GS-LICENSE.txt", "licenses", "describe.json", "README.md", "README_zh.md", "CHANGELOG.md", "THIRD_PARTY.md"],
  "scripts": {
    "build": "node tools/build.mjs",
    "describe:extension": "node tools/describe.mjs",
    "test": "node --test test/*.test.mjs",
    "selfcheck": "npm run build && npm test",
    "drymount": "node --experimental-transform-types tools/drymount.mts",
    "preview": "node tools/preview.mjs",
    "prepublishOnly": "npm run selfcheck"
  },
  "dependencies": { "abcjs": "6.7.2", "spessasynth_core": "4.3.22" },
  "devDependencies": { "esbuild": "0.28.2" },
  "cortico": { "kind": "world", "api": 6, "displayName": "ABC 音乐", "icon": "assets/icon.png", "tags": ["creative"], "webUiClient": "dist/webui.js", "describe": "describe.json" }
}
